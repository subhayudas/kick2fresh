# Square Bookings integration (see README.md "Square booking setup" for the full walkthrough)
#
# Get these from https://developer.squareup.com/apps -> your app -> Credentials.
# Use the Sandbox access token first to test, then switch to Production when ready.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# https://developer.squareup.com/apps -> your app -> Locations
SQUARE_LOCATION_ID=
# Square Dashboard -> Staff -> Team -> the staff member who should receive drop-offs
SQUARE_TEAM_MEMBER_ID=

# Filled in automatically by `node scripts/setup-square-catalog.mjs` after the
# first three variables above are set — run it once, then paste the printed value here.
SQUARE_DROPOFF_SERVICE_VARIATION_ID=

# Optional overrides (defaults shown)
# SQUARE_API_VERSION=2025-01-23
# SQUARE_DROPOFF_DURATION_MINUTES=20
# SQUARE_TIMEZONE=America/Toronto

# Business hours for hourly drop-off slots (24h, local Quebec time). 9-18 means
# the last bookable slot is 17:00 and the shop closes at 18:00.
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
