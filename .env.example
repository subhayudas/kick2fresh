# Square Bookings integration (see README.md "Square booking setup" for the full walkthrough)
#
# Get these from https://developer.squareup.com/apps -> your app -> Credentials.
# Use the Sandbox access token first to test, then switch to Production when ready.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# https://developer.squareup.com/apps -> your app -> Locations
SQUARE_LOCATION_ID=
# Square Dashboard -> Staff -> Team -> the staff member who should receive drop-offs
SQUARE_TEAM_MEMBER_ID=

# Filled in automatically by `node scripts/setup-square-catalog.mjs` after the
# first three variables above are set, run it once, then paste the printed value here.
SQUARE_DROPOFF_SERVICE_VARIATION_ID=

# Google Ads "New Booking" conversion (see README.md "Google Ads conversion tracking").
# Google Ads -> Goals -> Conversions -> New Booking -> Tag setup. From the event snippet
# 'send_to': 'AW-123456789/AbC-dEfGhIjK', the part before the slash is the ID, after it the label.
# Build-time values: rebuild/redeploy after changing them. Leave blank to disable tracking.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=

# Optional second Google Ads conversion: "Lead" (contact details submitted, before a
# time is picked). Create it as a Secondary goal; gives Smart Bidding far more volume
# than confirmed bookings alone. Same Tag setup page as the booking label above.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Direct contact (README "Conversion setup"). Digits with country code, e.g. 15145551234.
# Call / Text buttons appear in the hero, sticky bar and final CTA ONLY when set.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Optional: Zapier / Make / Slack / n8n webhook. Every lead (and 7+ pair quote request)
# is POSTed here as JSON the moment contact details are submitted, so a lead that never
# books is still something you can follow up on. Server-only.
LEAD_WEBHOOK_URL=

# Owner SMS alerts (see README.md "Owner SMS alerts"). Texts the shop when a booking
# or 7+ pair quote request comes in. Twilio Console -> Account SID / Auth Token, and a
# Twilio number that can send SMS. OWNER_NOTIFY_PHONE is who gets the text (several
# numbers separated by commas). Server-only. Leave any blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_NOTIFY_PHONE=

# Meta Pixel (see README.md "Meta Pixel tracking"). Events Manager -> Data Sources
# -> the pixel -> Settings gives the pixel ID. Build-time value: rebuild/redeploy
# after changing it. Leave blank to disable the pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (see README.md "Meta Conversions API"). Same Settings page,
# Conversions API -> Generate access token. Server-only - never expose with a
# NEXT_PUBLIC_ prefix. Leave blank to disable the server-side event.
META_CAPI_ACCESS_TOKEN=

# GA4 site + booking-form analytics (see README.md "GA4 analytics"). Analytics ->
# Admin -> Data Streams -> the web stream gives the Measurement ID ("G-XXXXXXX").
# Build-time value: rebuild/redeploy after changing it. Leave blank to disable.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Microsoft Clarity (see README.md "Microsoft Clarity"). clarity.microsoft.com ->
# the project -> Settings -> Setup gives the project id. Build-time value:
# rebuild/redeploy after changing it. Leave blank to disable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional overrides (defaults shown)
# SQUARE_API_VERSION=2025-01-23
# SQUARE_DROPOFF_DURATION_MINUTES=20
# SQUARE_TIMEZONE=America/Toronto

# Business hours for hourly drop-off slots (24h, local Quebec time). 9-18 means
# the last bookable slot is 17:00 and the shop closes at 18:00.
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
